# Safe placeholders only. Never commit real service or model-provider credentials.
# PostgreSQL is the only business database. For Docker Compose use host `postgres`;
# for host development replace it with the local SSH-tunnel address.
POSTGRES_DB=ai_resume
POSTGRES_USER=ai_resume
POSTGRES_PASSWORD=replace-with-postgres-password
DATABASE_URL=postgresql+asyncpg://ai_resume:replace-with-postgres-password@postgres:5432/ai_resume
APP_ENV=development
CELERY_BROKER_URL=redis://:replace-with-redis-password@127.0.0.1:6379/0
AUTH_REDIS_URL=redis://:replace-with-redis-password@127.0.0.1:6379/2
LOCAL_AUTH_SECRET=replace-with-at-least-32-random-bytes
LOCAL_EMAIL_OTP=123456
NEXT_PUBLIC_API_BASE_URL=/api
WEB_API_PROXY_TARGET=http://127.0.0.1:8000
AI_RUNTIME_MODE=production
AI_HOST=127.0.0.1
AI_PORT=3101
AI_SERVICE_TOKEN=replace-with-short-lived-random-service-token
AI_INTERNAL_URL=http://127.0.0.1:3101
AI_REDIS_URL=redis://:replace-with-redis-password@127.0.0.1:6379/1
TEST_REDIS_URL=
# Text resume workflows use DeepSeek. AI_MODEL_ROUTES_JSON can override this.
AI_TEXT_PROVIDER=deepseek
AI_TEXT_MODEL=deepseek-v4-flash
AI_TEXT_FALLBACK_MODEL=deepseek-v4-pro
DEEPSEEK_API_KEY=replace-with-deepseek-api-key
# Scanned PDFs remain disabled in MVP. These values reserve the Qwen vision route.
AI_PDF_VISION_ENABLED=false
AI_VISION_PROVIDER=qwen-token-plan-cn
AI_VISION_MODEL=qwen3.6-plus
QWEN_TOKEN_PLAN_CN_API_KEY=replace-with-qwen-token-plan-cn-api-key
AI_MODEL_ROUTES_JSON=
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=.data/objects
STORAGE_SIGNING_SECRET=replace-with-at-least-32-random-bytes
COS_REGION=replace-with-cos-region
COS_BUCKET=replace-with-cos-bucket
COS_SECRET_ID=replace-with-cos-secret-id
COS_SECRET_KEY=replace-with-cos-secret-key
