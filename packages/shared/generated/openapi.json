                  "$ref": "#/components/schemas/MatchCategory"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Match Category Contract"
      }
    },
    "/contracts/resume-snapshot": {
      "get": {
        "operationId": "resume_snapshot_contract_contracts_resume_snapshot_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResumeSnapshot"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Resume Snapshot Contract"
      }
    },
    "/contracts/suggestion-status": {
      "get": {
        "operationId": "suggestion_status_contract_contracts_suggestion_status_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuggestionStatus"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Suggestion Status Contract"
      }
    },
    "/contracts/task": {
      "get": {
