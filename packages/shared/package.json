{
  "name": "@resume/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./client-runtime": {
      "types": "./src/client.ts",
      "default": "./dist/src/client.js"
    },
    "./schema": "./generated/schema.ts",
    "./workflows": {
      "types": "./src/workflows.ts",
      "default": "./dist/src/workflows.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "dev": "tsc --watch --project tsconfig.json",
    "lint": "eslint src tests",
    "test": "vitest run"
  }
}
